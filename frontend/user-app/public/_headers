# Prevent caching of the main HTML file so latest JS/CSS bundles are always loaded
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Static assets have content-hashed filenames, so they can be cached forever
/static/*
  Cache-Control: public, max-age=31536000, immutable
